
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roblox Akinator Questions",
  "description": "Question definitions for Roblox Akinator.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "required": [
    "version",
    "questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.0
        }
      },
      "required": [
        "id",
        "feature",
        "prompt"
      ],
      "additionalProperties": false
    }
  }
}