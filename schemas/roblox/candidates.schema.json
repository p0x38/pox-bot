
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roblox Akinator Candidates",
  "description": "Candidate dataset for Roblox Akinator.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "required": [
    "version",
    "candidates"
  ],
  "additionalProperties": false,
  "$defs": {
    "candidate": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "required": [
        "user_id",
        "username",
        "display_name",
        "features"
      ],
      "additionalProperties": false
    }
  }
}