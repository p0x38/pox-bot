
import time
import discord
from discord.ext import commands, tasks
from discord import Color, Interaction, Role, TextChannel, app_commands

import lmstudio as lms

from bot import PoxBot
from logger import logger

class ReactionRoleCog(commands.Cog):
    def __init__(self, bot):
        self.bot: PoxBot = bot

    group = app_commands.Group(name="reaction_roles", description="Manage reaction roles")
    
    @group.command(name="add", description=app_commands.locale_str("command.reaction-roles.add.description"))
    @app_commands.checks.has_permissions(manage_roles=True)
    async def add(self, interaction: Interaction, message_id: str, emoji: str, role: Role):
        try:
            msg_id = int(message_id)
            target_msg = await interaction.channel.fetch_message(msg_id)
        except Exception as e:
            pass
async def setup(bot):
    await bot.add_cog(ReactionRoleCog(bot))