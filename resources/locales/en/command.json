    "admin": {
        "reload_cogs": {
            "description": "Reloads all bot extensions and synchronizes slash commands.",
            "embeds": {
                "loading": {
                    "title": "Processing reload...",
                    "description": "Please be patient while reloading...",
                    "progress": "Please be patient while reloading...\nCurrently loading: `%{current_cog}`\nProgress: **%{current}/%{total}**\nSuccess: **%{loaded}** | Failed: **%{failed}**"
                },
                "success": {
                    "title": "Reload process successfully done!",
                    "description": "Total **%{loaded}** extensions updated successfully.\nSynchronized **%{synched}** slash commands globally."
                },
                "error": {
                    "title": "Synchronization Failed!",
                    "description": "The extensions reloaded, but the global command sync failed."
                }
            },
            "errors": {
                "sync_failure": "Failed to sync: One or more commands contain invalid data structure.",
                "forbidden": "The bot lacks the `application.commands` scope in this guild.",
                "missing_id": "Critical Error: Application ID is missing from the bot instance.",
                "translation_error": "Sync aborted: An error occurred within the command translator.",
                "http_error": "Discord API error: Failed to communicate with the command gateway.",
                "generic": "An unknown error occurred during command synchronization."
            }
        }
    },
