{
    "8ball": {
        "description": "Gives a random, classic magic 8-ball response to a user's question.",
        "embeds": {
            "default": {
                "title": "Answer to a question '%{question}'"
            }
        }
    },
    "channel": {
        "description": "A group for managing channels.",
        "info": {
            "description": "Shows information for the target channel.",
            "embeds": {
                "default": {
                    "title": "Information for %{name}"
                }
            }
        },
        "slowmode": {
            "description": "Sets slowmode delay",
            "embeds": {
                "successful": {
                    "description": "Successfully set slowmode to **%{seconds}** for %{mention}! :D",
                    "title": "Slowmode Updated"
                }
            }
        }
    },
    "contributors": {
        "description": "A group for contributors.",
        "list": {
            "description": "Lists all contributors.",
            "embeds": {
                "default": {
                    "description": "Here's a list of contributors who helped my bot! :3",
                    "title": "Contributors"
                }
            }
        },
        "view": {
            "description": "Shows contributor information.",
            "embeds": {
                "default": {
                    "title": "Contributor Information for %{contributor}"
                }
            }
        }
    },
    "economy": {
        "balance": {
            "description": "Check your current balance.",
            "embeds": {
                "default": {
                    "footer": "Total Assets: %{coins} coins",
                    "title": "%{user}'s Balance :3"
                }
            },
            "fields": {
                "bank": "Bank",
                "wallet": "Wallets"
            }
        },
        "buy": {
            "description": "Buy an item from the shop.",
            "embeds": {
                "item_unavailable": {
                    "description": "That item is not available for sale! 3:<",
                    "title": "Item is unavailable"
                },
                "not_afford": {
                    "description": "You don't have enough coins in your wallet to buy that! 3:<",
                    "title": "Not enough coins"
                },
                "purchased": {
                    "description": "Successfully bought **%{item_name}**! Check your inventory~ ;3",
                    "title": "Purchase completed"
                }
            }
        },
        "daily": {
            "description": "Claim your daily reward.",
            "embeds": {
                "default": {
                    "description": "You got %{amount} coins by daily rewards! :3",
                    "title": "You've claimed daily reward!"
                }
            }
        },
        "deposit": {
            "description": "Move money from wallet to bank.",
            "embeds": {
                "default": {
                    "description": "Deposited %{amount} coins successfully. :3",
                    "title": "Deposit success"
                }
            }
        },
        "description": "A group for Economy system.",
        "history": {
            "description": "View your recent transactions."
        },
        "inventory": {
            "description": "View your items.",
            "embeds": {
                "default": {
                    "title": "%{user}'s inventory"
                },
                "empty": {
                    "description": "Your backpack is empty right now. Buy something to change this text i guess. :3",
                    "title": "Empty backpack"
                }
            }
        },
        "list": {
            "description": "View the item shop.",
            "fields": {
                "buy_price": "Price: %{price} coins",
                "not_sale": "Not for sale!! 3:<"
            }
        },
        "sell": {
            "description": "Sell an item back to the shop.",
            "embeds": {
                "sold": {
                    "description": "Sold **%{item_name}! :D",
                    "title": "Sale completed"
                },
                "unable_to_sell": {
                    "description": "The shop won't buy this back! 3:",
                    "title": "Unable to sell"
                }
            }
        },
        "withdraw": {
            "description": "Move money from bank to wallet.",
            "embeds": {
                "default": {
                    "description": "Withdrew %{amount} coins successfully. :3",
                    "title": "Withdraw success"
                }
            }
        },
        "work": {
            "description": "Earn some coins by working.",
            "embeds": {
                "default": {
                    "description": "You got %{amount} coins by working! :3",
                    "title": "You have worked for money!"
                },
                "tired": {
                    "description": "You need to rest %{rem} more minutes. 3:",
                    "title": "You can't work right now!"
                }
            }
        }
    },
    "info": {
        "commit_data": {
            "description": "Shows bot's latest git commit."
        },
        "description": "A group for information",
        "invite": {
            "description": "Invites the bot to server by application url. (LIMITED TO 90)",
            "embeds": {
                "default": {
                    "description": "%{prefix}\n\nYou can add me to your server using [this link!](%{invite_url}) :D",
                    "footer": "Note: Requires advanced permissions for full functionality, and the invitation is limited to 90 servers due to discord limitation!",
                    "status": {
                        "one": "Capacity: **%{formatted}** server",
                        "other": "Capacity: **%{formatted}** servers"
                    },
                    "title": "Invite TongueBot"
                }
            },
            "error": {
                "hardlimited": "You can't invite TongueBot right now, since the limit has been reached... 3:"
            }
        },
        "os_info": {
            "description": "Shows operating system information.",
            "embeds": {
                "default": {
                    "title": "Operating System Information"
                }
            }
        },
        "ping": {
            "description": "Pong!",
            "embeds": {
                "default": {
                    "title": "Pong! (%{latency} ms) :D"
                }
            }
        },
        "retrieve": {
            "description": "Retrieves bot information.",
            "embeds": {
                "default": {
                    "description": "Select a category below to view specific details! >:D",
                    "footer": "System: %{platform}",
                    "title": "Bot Information"
                }
            },
            "error": {
                "forbidden": "I do not have the **Manage Channels** permission to do that! D:"
            }
        },
        "sync": {
            "description": "Synchronizes commands"
        },
        "timedate": {
            "description": "Shows time in specified timezone",
            "embeds": {
                "default": {
                    "description": "In %{timezone_name}, it's **%{timedate}**. :3"
                }
            }
        }
    },
    "leveling": {
        "description": "Leveling system.",
        "rank": {
            "description": "Check rank.",
            "embeds": {
                "default": {
                    "fields": {
                        "level": {
                            "name": "Level"
                        },
                        "progress": {
                            "name": "Progress"
                        },
                        "total": {
                            "name": "Total XP"
                        }
                    },
                    "title": "%{user}'s rank"
                }
            }
        },
        "configure": {
            "description": "Configures leveling system.",
            "embeds": {
                "default": {
                    "title": "Leveling system updated",
                    "description": "The system has been updated! :D"
                }
            }
        }
    },
    "moderation": {
        "description": "Moderation management.",
        "togglefeature": {
            "description": "Toggle server features.",
            "embeds": {
                "default": {
                    "description": "Set %{feature_name} to %{state}! :3"
                }
            },
            "parameters": {
                "feature": {
                    "description": "The feature to toggle"
                },
                "state": {
                    "description": "On or Off"
                }
            }
        },
        "blacklist": {
            "description": "Blacklist system.",
            "add": {
                "description": "Adds a word to the blacklists.",
                "embeds": {
                    "default": {
                        "title": "Added word into blacklist",
                        "description": "Added %{entry} into blacklist with type '%{type}', and searchable with ID '%{id}'! :3"
                    }
                }
            },
            "remove": {
                "description": "Removes matched query from blacklists.",
                "embeds": {
                    "default": {
                        "title": "Removed matched queries from blacklist",
                        "description": "Removed every query matching with '%{query}'! :3"
                    },
                    "not_found": {
                        "title": "Triggers not found",
                        "description": "Triggers were not found from blacklist with matching query '%{query}'... 3:"
                    }
                }
            },
            "list": {
                "description": "Lists every blacklist triggers registered in this server.",
                "embeds": {
                    "default": {
                        "title": "Blacklist triggers registered in this server",
                        "footer": "And more %{remaining} triggers are registered. :3"
                    },
                    "no_blacklist": {
                        "description": "Blacklist trigger was not found from this server. 3:"
                    }
                }
            }
        }
    },
    "roblox": {
        "avatar": {
            "description": "Gets Roblox user's avatar by username.",
            "embeds": {
                "default": {
                    "title": "Roblox user %{username}'s Avatar"
                }
            }
        },
        "description": "A group for roblox APIs.",
        "user": {
            "description": "Get Roblox user info by username.",
            "embeds": {
                "default": {
                    "title": "User %{username}'s Information"
                }
            }
        }
    },
    "stats": {
        "description": "Leaderboard and statistics.",
        "top": {
            "description": "Show the top users.",
            "embeds": {
                "default": {
                    "title": "Global leaderboard!! >:D"
                }
            }
        }
    },
    "ticket": {
        "description": "Ticket system V2.",
        "setup": {
            "description": "Configure the ticket system for this server."
        }
    },
    "tts": {
        "description": "Center of TTS stuff",
        "embeds": {
            "default": {
                "description": "Generated! >:D",
                "footer": "Type: %{tts_type}; Input: %{input}",
                "title": "TTS Conversion"
            }
        },
        "google_translate": {
            "description": "Generates TTS from Google Translate."
        }
    },
    "user": {
        "avatar": {
            "description": "Shows Discord user's avatar.",
            "embeds": {
                "default": {
                    "footer": "Requested by %{author}, the result is cached for a minute. :3",
                    "title": "User %{user}'s avatar"
                }
            }
        },
        "description": "A group for users.",
        "info": {
            "description": "Retrieves user's information.",
            "embeds": {
                "default": {
                    "title": "Information for %{user}"
                }
            },
            "fields": {
                "stats": "Level %{level} (%{xp} XP) / %{messages} Messages",
                "wallet": "%{coins} Coins"
            }
        },
        "set_nick": {
            "description": "Sets user's nickname.",
            "embeds": {
                "changed": {
                    "description": "%{author} Changed %{user}'s nickname to **%{new_nickname}**! :3"
                },
                "reset": {
                    "description": "%{author} Reset %{user}'s nickname! :D"
                }
            },
            "reasons": {
                "changed": "Nickname changed by %{user} via /user nick",
                "reset": "Nickname reset by %{user} via /user nick"
            }
        },
        "status": {
            "description": "Retrieves user's status.",
            "embeds": {
                "default": {
                    "title": "%{user}'s Discord status"
                }
            }
        }
    },
    "welcome": {
        "description": "A group for WelcomeCog",
        "embeds": {
            "join": {
                "description": "Welcome, %{mention}! Please check out the rules in %{rules_mention}. :3",
                "description_no_rules": "Welcome to the server, %{mention}! x3",
                "footer": "We now have %{count} members.",
                "title": "Welcome to %{guild}!"
            },
            "left": {
                "description": "Goodbye, %{display}! :3",
                "title": "Member %{display} has left %{guild}... 3:"
            }
        },
        "set_channel": {
            "description": "Set channel to send join / leave message.",
            "embeds": {
                "disabled": {
                    "description": "Welcome notification feature has been disabled! :3"
                },
                "enabled": {
                    "description": "Welcome notification feature has been enabled.\n The welcome message will appear at %{target_mention}! :3"
                }
            }
        },
        "set_rules_channel": {
            "description": "Sets rule channel for adding link in it.",
            "embeds": {
                "disabled": {
                    "description": "Rules channel for welcome message has been removed! :3"
                },
                "success": {
                    "description": "Rules channel for welcome message has been set to %{target_mention}! :3"
                }
            }
        },
        "test": {
            "description": "Run a test for welcome channel",
            "embeds": {
                "sent": {
                    "description": "Test successfully sent to welcome channel! :D"
                },
                "unconfigured": {
                    "description": "Welcome channel hasn't been configured. 3:"
                }
            }
        }
    }
}